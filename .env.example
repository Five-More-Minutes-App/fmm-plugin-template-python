# Where Five More Minutes can be reached from this computer. It has to be on the same network:
# the service refuses plugins from the internet.
FMM_URL=http://192.168.1.10:5072

# A key made in the portal (Plugins -> Developer -> Create key). It is shown once, so copy it now.
# Treat it like a password: this file is in .gitignore, and it should stay that way.
FMM_API_KEY=fmmk_paste_the_whole_key_here
